    "@yao-pkg/pkg": "^6.11.0",
    "cli-progress": "3.12.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.27.2",
    "inquirer": "^8.2.7",
    "kleur": "4.1.5",
    "nanoevents": "^9.1.0",
    "puppeteer-core": "^24.35.0",
    "typescript": "^5.9.3"
  },
  "prettier": {
    "printWidth": 120,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "pkg": {
    "scripts": "dist/index.js",
    "outputPath": "dist",
    "assets": [
      "dist/vips"
    ],
    "targets": [
      "node18-win"
    ]
